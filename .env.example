# Copy to .env and fill in. .env is gitignored — never commit real keys.

# ---------------------------------------------------------------------
# Backend selection
#   auto   - probe Ollama, fall back to Gemini   (good default locally)
#   ollama - always local Ollama
#   gemini - always Google Gemini                (required in the cloud)
# ---------------------------------------------------------------------
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=auto

# --- Ollama (local development) --------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Google Gemini (cloud) -------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# --- Chunking / retrieval --------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5

# --- Storage ----------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
DOCS_DIR=./documents

# --- HTTP -------------------------------------------------------------
# "*" is fine locally. In production name the frontend origin explicitly,
# e.g. https://document-ai-platform.vercel.app (comma-separated for several).
CORS_ALLOW_ORIGINS=*
